# ============================================
# Backend environment variables (Spring Boot)
# Copy this file to `.env` ONLY for local tools
# that read it. NEVER commit `.env` to GitHub.
# On Render, add these in the service dashboard.
# ============================================

# --- Database (MySQL) ---
# Production (Aiven MySQL). Copy these five values from your Aiven service page
# (Service Overview tab):
#   Host        -> Host
#   Port        -> Port for MySQL
#   Database    -> Database name
#   User        -> User
#   Password    -> Password
# JDBC URL format for Spring Boot (note: Aiven MySQL requires TLS, and the
# database already exists, so no createDatabaseIfNotExist in production):
#   jdbc:mysql://HOST:PORT/DATABASE?sslMode=REQUIRED&serverTimezone=UTC
# Example (replace the UPPERCASE parts with the values copied from Aiven):
# DB_URL=jdbc:mysql://YOUR-AIVEN-HOST:YOUR-AIVEN-PORT/YOUR-AIVEN-DB?sslMode=REQUIRED&serverTimezone=UTC

# Local development only - used automatically if DB_URL / DB_USERNAME / DB_PASSWORD
# are not set in the environment. Production on Render overrides these.
DB_URL=jdbc:mysql://localhost:3306/auth_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# --- Security ---
# JWT signing secret, must be at least 32 characters (256 bits). Use a long random string.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# --- Server ---
# Render injects PORT automatically. Leave this commented for Render;
# uncomment only for running on a custom port locally.
# PORT=8081

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
# Include your Vercel frontend URL in production.
# Example: https://my-app.vercel.app,http://localhost:8081
ALLOWED_ORIGINS=http://localhost:8081