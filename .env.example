# ============================================
# Backend environment variables (Spring Boot)
# Copy this file to `.env` ONLY for local tools
# that read it. NEVER commit `.env` to GitHub.
# On Render, add these in the service dashboard.
# ============================================

# --- Database (production MySQL) ---
# Format: jdbc:mysql://HOST:PORT/DBNAME?useSSL=true&requireSSL=true&serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/auth_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# --- Security ---
# JWT signing secret, must be at least 32 characters (256 bits). Use a long random string.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# --- Server ---
# Render injects PORT automatically. Leave this commented for Render;
# uncomment only for running on a custom port locally.
# PORT=8081

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
# Include your Vercel frontend URL in production.
# Example: https://my-app.vercel.app,http://localhost:8081
ALLOWED_ORIGINS=http://localhost:8081