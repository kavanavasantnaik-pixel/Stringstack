# Frontend configuration (Vercel static hosting)
#
# This project's frontend is plain HTML/CSS/JavaScript (no build framework),
# so instead of a Vite-style build-time .env file, the backend API URL is
# injected into public/config.js by scripts/build-config.js at deploy time.
#
# Copy this file to .env only if you deploy with the Vercel CLI and want to
# preview the build locally. In the Vercel web dashboard, add these as
# Environment Variables for the frontend project.

# The full URL of your backend API (no trailing slash). Example:
# https://YOUR-BACKEND.onrender.com
API_BASE_URL=https://YOUR-BACKEND.onrender.com

# Variable-name aliases accepted by the same build script (use only one)
VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com
VITE_API_URL=https://YOUR-BACKEND.onrender.com